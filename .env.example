EVENT_RESEARCH_DATABASE_PATH=data/event_research.sqlite3
EVENT_GRAPH_DATABASE_PATH=data/event_graph.sqlite3
EVENT_DEBATE_DATABASE_PATH=data/event_debate.sqlite3
EVENT_REQUEST_TIMEOUT=20
EVENT_API_WRITE_KEY=change-me-before-enabling-model-requests
EVENT_API_CORS_ORIGINS=http://localhost:5173
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-flash
LLM_ENABLED=false
# 企业事件规划单次费用估算上限；DeepSeek Flash 使用代码中的官方峰时单价。
EVENT_LLM_MAX_USD_PER_RUN=0.01
# 阶段四事件提取单次费用估算上限，和规划预算分开计算。
EVENT_GRAPH_MAX_USD_PER_RUN=0.06
EVENT_DEBATE_MAX_USD_PER_RUN=0.08
# 若改用其他模型，必须填入其每百万 Token 的输入/输出美元单价。
EVENT_LLM_INPUT_USD_PER_1M=
EVENT_LLM_OUTPUT_USD_PER_1M=

